# Public, non-secret configuration
NEXT_PUBLIC_HOODIEPAD_CHAIN_ID=4663

# Server-only provider credential. Never expose with a NEXT_PUBLIC_ prefix.
Alchemy_API_KEY=

# Server-only funded deployment signer. Keep only in .env.local.
EVM_RH_PK=

# Optional server-side RPC override.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Broadcast remains disabled until an explicitly approved release runbook.
HOODIEPAD_BROADCAST_ENABLED=false
