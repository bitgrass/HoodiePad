# Public, non-secret configuration
NEXT_PUBLIC_HOODIEPAD_CHAIN_ID=4663

# Server-only provider credential. Never expose with a NEXT_PUBLIC_ prefix.
Alchemy_API_KEY=

# Optional server-side RPC override.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Optional upstream RPC override used only by the disposable Anvil fork.
HOODIEPAD_FORK_RPC_URL=
HOODIEPAD_FORK_BLOCK=

# Optional caller used by the read-only verification CLI.
HOODIEPAD_SIMULATION_CREATOR=

# Both switches must be true before the API returns MetaMask deployment calldata.
HOODIEPAD_EXTERNAL_REVIEW_APPROVED=false
HOODIEPAD_BROADCAST_ENABLED=false
